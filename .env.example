# GEMINI_API_KEY: Required for Gemini AI API calls.
# For local testing, set this manually in your environment file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"

# ALCO_ALLOW_MOCK_AUTH: Keep true only for local development if you still rely on mock auth.
ALCO_ALLOW_MOCK_AUTH="true"
